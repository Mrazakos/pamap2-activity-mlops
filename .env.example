# Copy to .env (git-ignored, chmod 600) and adjust. Read by slurm/mlflow_env.sh (bash) and python-dotenv,
# so quote values with single quotes if they contain spaces or `$`.

# University MLflow server (reachable from deep21 and the compute nodes, not from the laptop).
# Artifacts are uploaded through the server, so MLFLOW_ARTIFACT_ROOT is not set here.
MLFLOW_TRACKING_URI=http://10.3.6.35:5000
MLFLOW_TRACKING_USERNAME=<neptun-code>
MLFLOW_TRACKING_PASSWORD='<password>'
MLFLOW_EXPERIMENT=shmqak-pamap2-har

# Without .env the interim store is used: sqlite:////shared/shmqak/mlflow/mlflow.db with
# artifacts in /shared/shmqak/mlflow/artifacts (see slurm/mlflow_env.sh).

# Logging: text (default) or json; LOG_FILE adds a JSON-lines file handler.
# LOG_FORMAT=json
# LOG_FILE=runs/app.log
