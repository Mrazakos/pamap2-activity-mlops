# Copy to .env (git-ignored) and adjust. Loaded automatically via python-dotenv.
# The Slurm scripts export the same variables, so .env is only needed for manual runs.

# Interim store: SQLite + filesystem artifacts on the shared cluster disk (four slashes = absolute path).
# Replace with the university MLflow server URL once it is known; no code change is needed.
MLFLOW_TRACKING_URI=sqlite:////shared/shmqak/mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=/shared/shmqak/mlflow/artifacts
MLFLOW_EXPERIMENT=shmqak-pamap2-har

# Only if the university server needs authentication (never commit real values):
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# Logging: text (default) or json; LOG_FILE adds a JSON-lines file handler.
# LOG_FORMAT=json
# LOG_FILE=runs/app.log
